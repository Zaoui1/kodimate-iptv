#!/bin/sh
#
# Gradle start up script for POSIX generated by "Gradle Build Init plugin"
#
# Important for running:
#
# (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#     noncompliant, but you have some other POSIX-compliant shell such as ksh or
#     bash, then to run this script, type that shell name before the whole
#     command line, like:
#
#         ksh Gradle
#
# (2) Nominate the script to be executable:  chmod +x gradlew
#

set -e

DIRNAME=$(dirname "$0")
APP_HOME=$(cd "$DIRNAME" && pwd)

# Determine Java executable
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" &> /dev/null; then
    echo "ERROR: JAVA_HOME is not set and java command not found." >&2
    exit 1
fi

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"

exec "$JAVACMD" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
